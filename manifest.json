{
  "manifest_version": 3,
  "name": "Click-to-Load Images",
  "version": "0.1.0",
  "description": "Blocks images, video, and audio by default to save cellular data. Tap a placeholder to load that one item on demand.",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "scripting",
    "tabs",
    "contextMenus"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Click-to-Load Images: tap to toggle blocking globally (right-click for per-site and more)"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/domain.js", "lib/rules.js", "lib/decisions.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "block-media",
        "enabled": true,
        "path": "rules/block-media.json"
      }
    ]
  },
  "options_page": "options.html",
  "commands": {
    "toggle-site-blocking": {
      "suggested_key": {
        "default": "Alt+Shift+I"
      },
      "description": "Toggle image/video/audio blocking for the current site"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
